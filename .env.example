# Local PostgreSQL credentials. Use different secrets outside local development.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5433

# NestJS backend
DATABASE_URL=postgresql://portfolio:replace-with-a-local-password@localhost:5433/portfolio?schema=public
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=AppsCyclone.sid
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800
# Keep 0 locally. Set to 1 only when the app is directly behind one trusted
# HTTPS reverse proxy such as Tailscale Funnel/ngrok on the same host.
TRUST_PROXY_HOPS=0

# One-off evaluator/test user provisioning. Do not commit real values.
PROVISION_USER_EMAIL=evaluator@example.com
PROVISION_USER_PASSWORD=replace-with-a-secret-password
